---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReactSitePage from "../components/ReactSitePage.astro";
import { calculators } from "../data/site-data";
import { siteConfig } from "../data/site-config";

export function getStaticPaths() {
  const staticRoutes = ["", "calculators", "guides", "about", "contact", "privacy", "terms"];
  return [...staticRoutes, ...calculators.map(([slug]) => slug)].map((slug) => ({
    params: { slug: slug || undefined },
    props: { slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const calculator = calculators.find(([candidate]) => candidate === slug);
const titles: Record<string, string> = {
  "": "Free Flooring Calculators",
  calculators: "All Flooring Calculators",
  guides: "Flooring Measurement Guides",
  about: "About",
  contact: "Contact",
  privacy: "Privacy Policy",
  terms: "Terms of Use",
};
const title = calculator?.[1] ?? titles[slug];
const descriptions: Record<string, string> = {
  "": siteConfig.description,
  calculators: "Explore six free FloorsCalc tools for flooring area, tile, vinyl plank, laminate, hardwood, and carpet material planning.",
  guides: "Practical flooring measurement guidance covering room area, material allowance, box coverage, carpet estimates, units, and rounding.",
  about: "Learn how FloorsCalc provides transparent, practical flooring material estimates without pricing assumptions or hidden formulas.",
  contact: `Contact ${siteConfig.name} with a question about a flooring calculator, calculation, guide, or the website.`,
  privacy: "Read the FloorsCalc Privacy Policy covering contact-form information, technical data, cookies, security, and your privacy choices.",
  terms: "Read the FloorsCalc Terms of Use for calculator estimates, acceptable use, intellectual property, and limitations of liability.",
};
const description = calculator?.[2] ?? descriptions[slug];
const hydrated = Boolean(calculator) || slug === "contact";
---
<BaseLayout title={title} description={description} path={slug ? `/${slug}` : "/"}>
  <ReactSitePage slug={slug} hydrate={hydrated} />
</BaseLayout>
